# ============================================================
# Jeu Instant Gagnant — variables d'environnement (production)
# Copier ce fichier en .env puis renseigner les valeurs.
# ============================================================

# Mot de passe de l'espace admin.
# En production, si laissé vide, un mot de passe aléatoire est généré
# et affiché dans les logs au démarrage.
ADMIN_PASSWORD=

# Secret de signature des jetons admin (chaîne longue et aléatoire).
# Si laissé vide, un secret aléatoire est généré à chaque démarrage
# (les sessions admin expirent alors à chaque redémarrage).
ADMIN_SECRET=

# Port d'écoute (défaut 8000)
PORT=8000

# Répertoire de stockage des données (défaut ./data).
# Sur un hébergeur avec volume persistant, pointer vers ce volume.
# DATA_DIR=/app/data

# Mode production (recommandé)
NODE_ENV=production
